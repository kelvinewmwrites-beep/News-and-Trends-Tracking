# Optional: enables Claude-written content ideas. Without this, a
# deterministic template-based generator is used instead.
ANTHROPIC_API_KEY=

# Model used for content idea generation (only relevant if ANTHROPIC_API_KEY is set).
CONTENT_IDEA_MODEL=claude-sonnet-5

# Minutes between automatic background news ingests.
SGNEWS_INGEST_INTERVAL_MIN=15

# Set to 1 to disable the background cron scheduler (e.g. on serverless hosts
# without a long-lived process; trigger POST /api/ingest externally instead).
SGNEWS_DISABLE_SCHEDULER=
